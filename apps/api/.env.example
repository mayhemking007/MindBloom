# Local development database. For Neon, replace this with your Neon pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindbloom

# Used by memo-grafter, embeddings, Bloom, notes, and reflection generation.
OPENAI_API_KEY=
NOTION_TOKEN=

# Express API. Render sets PORT automatically; API_PORT is for local development.
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
MEMO_GRAFTER_EMBEDDING_MODEL=text-embedding-3-small
MEMO_GRAFTER_LLM_MODEL=gpt-4o-mini
# Optional. Set this and uncomment cache or queue in src/memo-grafter/mg.config.ts.
# Example: REDIS_URL=redis://localhost:6379
REDIS_URL=
