# Local development database. For Neon, replace this with your Neon pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindbloom

# Used by memo-grafter, embeddings, Bloom, notes, and reflection generation.
OPENAI_API_KEY=
NOTION_TOKEN=
# Phase 2: use "hybrid" while migrating the internal token, then switch to "oauth".
NOTION_CONNECTION_MODE=hybrid
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:4100/api/notion/oauth/callback
# Exactly 32 UTF-8 bytes, or prefix a 32-byte base64 value with "base64:".
NOTION_TOKEN_ENCRYPTION_KEY=
NOTION_TOKEN_ENCRYPTION_KEY_VERSION=v1
NOTION_CONTENT_API=markdown
NOTION_MAX_PAGES_PER_IMPORT=25
NOTION_DAILY_IMPORT_PAGE_LIMIT=250

# Express API. Render sets PORT automatically; API_PORT is for local development.
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# Standalone Notion Bloom API and web application.
NOTION_API_PORT=4100
NOTION_CORS_ORIGIN=http://localhost:5174
MEMO_GRAFTER_EMBEDDING_MODEL=text-embedding-3-small
MEMO_GRAFTER_LLM_MODEL=gpt-4o-mini
# Optional. Set this and uncomment cache or queue in src/memo-grafter/mg.config.ts.
# Example: REDIS_URL=redis://localhost:6379
REDIS_URL=
